+// XexGetModuleSection (ordinal 0x196)
+// Guest ABI: r3 = module handle, r4 = ANSI resource name, r5 = address out,
+// r6 = size out -> r3 = NTSTATUS. XEX_HEADER_RESOURCE_INFO is an offset-backed
+// header whose first BE32 is its total size, followed by 16-byte records
+// (8-byte name, BE32 address, BE32 size).
+bool xex_get_module_section_export(GuestModuleRegistry& registry, const XexImage& image,
+                                   core::ExportCallContext& context) {
+  const auto handle = static_cast<cpu::GuestAddress>(context.cpu.gpr[3]);
+  const auto name_ptr = static_cast<cpu::GuestAddress>(context.cpu.gpr[4]);
+  const auto address_out = static_cast<cpu::GuestAddress>(context.cpu.gpr[5]);
+  const auto size_out = static_cast<cpu::GuestAddress>(context.cpu.gpr[6]);
+  if (name_ptr == 0u || address_out == 0u || size_out == 0u) {
+    context.cpu.gpr[3] = kStatusInvalidParameter;
+    return true;
+  }
+
+  const auto executable = registry.module_handle("");
+  if (!executable || (handle != 0u && handle != *executable)) {
+    context.cpu.gpr[3] = registry.is_module_handle(handle) ? kStatusNotFound : kStatusInvalidHandle;
+    return true;
+  }
+
+  context.memory.write32_be(address_out, 0u);
+  context.memory.write32_be(size_out, 0u);
+  const auto wanted = read_guest_cstring(context.memory, name_ptr, 9u);
+  std::size_t info_offset = 0u;
+  if (wanted.empty() ||
+      !find_offset_optional_header(image.header_bytes, kXexHeaderResourceInfo, info_offset) ||
+      info_offset + 4u > image.header_bytes.size()) {
+    context.cpu.gpr[3] = kStatusNotFound;
+    return true;
+  }
+
+  const auto info_size = static_cast<std::size_t>(read_be32(image.header_bytes, info_offset));
+  if (info_size < 4u || info_offset + info_size > image.header_bytes.size()) {
+    context.cpu.gpr[3] = kStatusNotFound;
+    return true;
+  }
+  for (std::size_t record = info_offset + 4u; record + 16u <= info_offset + info_size;
+       record += 16u) {
