+bool ob_open_object_by_name_export(kernel::KernelProcess& process, ExportCallContext& context) {
+  const auto attributes_ptr = static_cast<cpu::GuestAddress>(context.cpu.gpr[3]);
+  const auto handle_out = static_cast<cpu::GuestAddress>(context.cpu.gpr[6]);
+  if (attributes_ptr == 0u || handle_out == 0u) {
+    context.cpu.gpr[3] = status::InvalidParameter;
+    return true;
+  }
+
+  // Xbox OBJECT_ATTRIBUTES is three BE32 fields. Validate the nested
+  // ANSI_STRING as well, even though the current KernelProcess does not yet
+  // expose a named-object directory to resolve it against.
+  const auto name_ptr = context.memory.read32_be(attributes_ptr + 4u);
+  if (name_ptr == 0u) {
+    context.cpu.gpr[3] = status::ObjectNameInvalid;
+    return true;
+  }
+  const auto name_length = context.memory.read16_be(name_ptr);
+  const auto name_buffer = context.memory.read32_be(name_ptr + 4u);
+  if (name_length == 0u || name_buffer == 0u) {
+    context.cpu.gpr[3] = status::ObjectNameInvalid;
+    return true;
+  }
+  // Touch the bounded name range so malformed guest pointers fail through
+  // the runtime's normal MemoryFault path instead of looking like a miss.
+  for (std::uint16_t i = 0u; i < name_length; ++i) {
+    static_cast<void>(context.memory.read8(name_buffer + i));
+  }
+
+  std::string object_name;
+  object_name.reserve(name_length);
+  for (std::uint16_t i = 0u; i < name_length; ++i) {
+    object_name.push_back(static_cast<char>(context.memory.read8(name_buffer + i)));
+  }
+  auto object = process.find_named_object(object_name);
+  if (!object) {
+    context.memory.write32_be(handle_out, 0u);
+    context.cpu.gpr[3] = status::ObjectNameNotFound;
+    return true;
+  }
+
+  Handle handle{};
+  const auto code = process.handle_table().insert(
+      std::move(object), /*granted_access=*/0xFFFFFFFFu,
+      kernel::HandleFlags::None, handle);
+  if (code != KernelIoCode::Success) {
+    context.memory.write32_be(handle_out, 0u);
+    context.cpu.gpr[3] = status::Unsuccessful;
+    return true;
+  }
+  context.memory.write32_be(handle_out, handle);
+  context.cpu.gpr[3] = status::Success;
+  return true;
+}
