+void KernelProcess::publish_named_object(
+    std::string name, std::shared_ptr<KernelObject> object) {
+  if (name.empty() || !object) return;
+  std::lock_guard lock(named_objects_mutex_);
+  named_objects_.try_emplace(std::move(name), std::move(object));
+}
+
+std::shared_ptr<KernelObject> KernelProcess::find_named_object(
+    const std::string& name) const {
+  std::lock_guard lock(named_objects_mutex_);
+  const auto it = named_objects_.find(name);
+  return it == named_objects_.end() ? nullptr : it->second;
+}
