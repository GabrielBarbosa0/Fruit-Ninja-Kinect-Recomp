+void test_named_semaphore_opens_as_the_same_object() {
+  Fixture f;
+  constexpr char kName[] = "WorkerThreadSemaphore";
+  constexpr std::uint16_t kNameLength = sizeof(kName) - 1u;
+
+  const auto name_buffer = f.alloc(kNameLength, 1u);
+  for (std::uint16_t i = 0; i < kNameLength; ++i) {
+    f.address_space->write8(name_buffer + i, static_cast<std::uint8_t>(kName[i]));
+  }
+  const auto ansi_string = f.alloc(8u);
+  f.address_space->write16_be(ansi_string, kNameLength);
+  f.address_space->write16_be(ansi_string + 2u, kNameLength + 1u);
+  f.address_space->write32_be(ansi_string + 4u, name_buffer);
+  const auto attributes = f.alloc(12u);
+  f.address_space->write32_be(attributes, 0u);
+  f.address_space->write32_be(attributes + 4u, ansi_string);
+  f.address_space->write32_be(attributes + 8u, 0u);
+
+  const auto created_handle_out = f.alloc32();
+  cpu::CpuState create{};
+  create.gpr[3] = created_handle_out;
+  create.gpr[4] = attributes;
+  create.gpr[5] = 0u;
+  create.gpr[6] = 2u;
+  assert(f.invoke(0x0D5u, create).success && create.gpr[3] == 0u);
+  const auto created_handle = f.address_space->read32_be(created_handle_out);
+
+  const auto opened_handle_out = f.alloc32();
+  cpu::CpuState open{};
+  open.gpr[3] = attributes;
+  open.gpr[6] = opened_handle_out;
+  assert(f.invoke(0x10Du, open).success && open.gpr[3] == 0u);
+  const auto opened_handle = f.address_space->read32_be(opened_handle_out);
+  assert(opened_handle != 0u && opened_handle != created_handle);
+
+  kernel::HandleView created_view{};
+  kernel::HandleView opened_view{};
+  assert(f.process->handle_table().lookup(created_handle, created_view) ==
+         kernel::KernelIoCode::Success);
+  assert(f.process->handle_table().lookup(opened_handle, opened_view) ==
+         kernel::KernelIoCode::Success);
+  assert(created_view.object == opened_view.object);
+  assert(created_view.object->type() == kernel::ObjectType::Semaphore);
+}
