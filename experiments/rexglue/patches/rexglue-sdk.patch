--- a/include/rex/chrono/chrono.h
+++ b/include/rex/chrono/chrono.h
@@ -116,6 +116,19 @@ using XSystemClock = detail::NtSystemClock<detail::Domain::Guest>;
 
 namespace std::chrono {
 
+// LLVM-MinGW currently ships a libc++ configuration whose chrono feature set
+// predates C++20 clock_cast. ReXGlue only needs its explicitly specialised
+// clock pairs, so provide the standard customization point on that toolchain.
+#if !defined(__cpp_lib_chrono) || __cpp_lib_chrono < 201907L
+template <typename DestClock, typename SourceClock>
+struct clock_time_conversion;
+
+template <typename DestClock, typename SourceClock, typename Duration>
+constexpr auto clock_cast(const std::chrono::time_point<SourceClock, Duration>& source) {
+  return clock_time_conversion<DestClock, SourceClock>{}(source);
+}
+#endif
+
 template <>
 struct clock_time_conversion<::rex::chrono::WinSystemClock, ::rex::chrono::XSystemClock> {
   using WClock_ = ::rex::chrono::WinSystemClock;
